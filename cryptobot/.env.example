# =============================================================================
#  cryptobot -- environment overrides.  NO SECRETS ARE NEEDED, EVER.
#
#  This bot reads only PUBLIC market data and never sends an order, so there is
#  nothing to authenticate.  Do NOT put exchange API keys here: the bot does not
#  read them, and cryptobot/config.py actively refuses a config file that looks
#  like it contains credentials.
#
#  Copy to .env (or export these) only if you want to change behaviour.
# =============================================================================

# --- trading mode ------------------------------------------------------------
# Allowed: paper | backtest.  Anything else (live, real, production, ...) makes
# cryptobot.safety raise LiveTradingForbidden and the process exits with code 3.
CRYPTOBOT_MODE=paper

# --- capital & targets -------------------------------------------------------
CRYPTOBOT_INITIAL_CAPITAL_USDT=50.0
CRYPTOBOT_NET_PROFIT_TARGET_PCT=2.0
CRYPTOBOT_STOP_LOSS_PCT=2.5
CRYPTOBOT_MAX_POSITION_PCT=90.0
CRYPTOBOT_MAX_OPEN_POSITIONS=1
CRYPTOBOT_DAILY_LOSS_LIMIT_PCT=5.0
CRYPTOBOT_COOLDOWN_MINUTES=60
# Hard cap on NEW ENTRIES per UTC day (closes do not consume this budget).
CRYPTOBOT_MAX_TRADES_PER_DAY=8

# --- market ------------------------------------------------------------------
CRYPTOBOT_PAIRS=BTC/USDT,ETH/USDT
CRYPTOBOT_TIMEFRAME=1h

# --- costs (realistic costs dominate small-account results) ------------------
CRYPTOBOT_FEE_PCT=0.1
CRYPTOBOT_SLIPPAGE_PCT=0.05

# --- paths -------------------------------------------------------------------
CRYPTOBOT_CACHE_DIR=data/cache
# REAL-TIME PAPER MODE ONLY: newest cached bar older than this many bars is stale
# (refreshed from the exchange; if unreachable -> cache-stale, complete=False, no new entries).
# Ignored by backtest and --replay, which use historical candles on purpose.
CRYPTOBOT_MAX_CACHE_AGE_BARS=3
CRYPTOBOT_DB_PATH=data/ledger.sqlite
CRYPTOBOT_REPORTS_DIR=reports
CRYPTOBOT_RUN_DIR=run
CRYPTOBOT_LOG_LEVEL=INFO

# --- kill switch (must stay 0/false; 1 makes the process refuse to start) -----
CRYPTOBOT_LIVE=0

# =============================================================================
#  MOBILE NOTIFICATIONS (optional).  The layer NEVER places orders and can never
#  affect a trading decision.  Setup guide (Turkish): NOTIFICATIONS.md
#
#  Default path needs NO account: install the free ntfy app, subscribe to a
#  topic, and set CRYPTOBOT_NTFY_TOPIC below.  Secrets are read from the
#  environment only -- never put them in config.yaml.
#
#  ⚠️  Scope this to the process that needs it (the launcher start-bot.cmd does
#  exactly that).  Do NOT set CRYPTOBOT_NTFY_TOPIC as a persistent User/System
#  variable: every Python process on the machine would inherit it, turning the
#  test suite and the verification scripts into real publishers.
# =============================================================================

# --- master switches (optional) ----------------------------------------------
# CRYPTOBOT_NOTIFY_ENABLED=1            # 0 turns the whole layer off
# CRYPTOBOT_NOTIFY_DRY_RUN=0            # 1 = render only, never send
# CRYPTOBOT_NOTIFY_PROVIDERS=console,file,ntfy
# Trade-only default: a push when a position OPENS and when it CLOSES.
# Add any other event name to opt back in (they all stay implemented):
# CRYPTOBOT_NOTIFY_ON=position_opened,position_closed,risk_halted,daily_summary
# CRYPTOBOT_NOTIFY_MIN_SEVERITY=info    # info | warning | critical
# CRYPTOBOT_NOTIFY_DEDUPE_SECONDS=300   # suppress identical repeats for N seconds
# CRYPTOBOT_NOTIFY_MAX_PER_HOUR=20      # hourly send cap
# CRYPTOBOT_NOTIFY_QUIET_HOURS=22:00-07:00   # local time; only critical gets through
# CRYPTOBOT_NOTIFY_TIMEOUT_SECONDS=10
# CRYPTOBOT_NOTIFY_RETRY_MAX=2          # total attempts = 1 + this (hard cap 10)

# --- ntfy (default: free, no account) ----------------------------------------
# Pick a LONG, RANDOM topic name: anyone who knows it can read the messages on
# a public ntfy server, and a free mirror also sees the contents.  Example:
# cryptobot-paper-6c6de613c4-db65cc46fe
# CRYPTOBOT_NTFY_TOPIC=cryptobot-paper-CHANGE-ME-TO-A-RANDOM-NAME
# ntfy.sh can be unreachable on some networks; ntfy.envs.net is a verified
# reachable free mirror (the launcher's default).  A self-hosted server is best.
# CRYPTOBOT_NTFY_HOST=ntfy.envs.net      # or https://your-own-ntfy.example.org
# CRYPTOBOT_NTFY_TOKEN=                 # only for a protected/self-hosted server
# CRYPTOBOT_NTFY_TAGS=                  # override the per-severity tag
# CRYPTOBOT_NTFY_CLICK=                 # URL opened when the notification is tapped

# --- telegram (only active when BOTH values are set; add telegram to providers)
# CRYPTOBOT_TELEGRAM_BOT_TOKEN=123456789:AA...
# CRYPTOBOT_TELEGRAM_CHAT_ID=123456789
# CRYPTOBOT_TELEGRAM_API_BASE=https://api.telegram.org   # self-hosted Bot API only

# --- generic webhook (Discord / Slack / Zapier / n8n) ------------------------
# CRYPTOBOT_WEBHOOK_URL=https://discord.com/api/webhooks/...
